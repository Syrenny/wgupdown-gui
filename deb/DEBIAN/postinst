#!/bin/bash
set -e

if ! getent group wgupdown >/dev/null; then
    groupadd --system wgupdown
fi

if [ -n "$SUDO_USER" ] && id "$SUDO_USER" >/dev/null 2>&1; then
    usermod -aG wgupdown "$SUDO_USER"
fi

echo "-------------------------------------------------"
echo "wgupdown-gui installed."
echo "Users in group wgupdown can manage VPN from GUI without password."
echo "Log out and back in if group membership has just changed."
echo "-------------------------------------------------"

exit 0
